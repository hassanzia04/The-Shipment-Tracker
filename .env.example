# Database
DB_USER=ffd
DB_PASSWORD=change-this-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://ffd:change-this-to-a-strong-password@localhost:5432/ffd_tracker

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OCI Object Storage — Instance Principals auth (no access keys needed on OCI compute)
# Only OCI_NAMESPACE is required; the rest have sensible defaults.
OCI_BUCKET_NAME=ffd-documents
OCI_REGION=me-dubai-1
OCI_NAMESPACE=

# Email — choose one provider and fill in the relevant section

# Option A: Gmail OAuth2 (current production setup)
EMAIL_PROVIDER=gmail
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
# Production: paste full contents of gmail_token.json here so the token
# survives container restarts without a file on disk.
GMAIL_TOKEN_DATA=
GMAIL_SENDER_EMAIL=

# Option B: Outlook / Office 365 SMTP (set EMAIL_PROVIDER=smtp to use)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=notifications@yourcompany.com
# SMTP_PASSWORD=
# SMTP_SENDER_EMAIL=notifications@yourcompany.com

# AI — used for daily report summary (optional, falls back gracefully if empty)
ANTHROPIC_API_KEY=

# App
FRONTEND_URL=http://localhost:3000
INVITATION_EXPIRE_HOURS=48
ENVIRONMENT=development
