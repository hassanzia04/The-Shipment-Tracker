# Database — DB_PASSWORD is required (no default). Use a strong random value.
DB_USER=ffd
DB_PASSWORD=change-this-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://ffd:change-this-to-a-strong-password@localhost:5432/ffd_tracker

# MinIO (local dev object storage) — required, no defaults
MINIO_USER=ffd_minio
MINIO_PASSWORD=change-this-to-a-strong-password

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OCI Object Storage (S3-compatible)
OCI_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
OCI_BUCKET_NAME=ffd-documents
OCI_REGION=me-abudhabi-1

# Email — Gmail API (switch to Outlook by changing EMAIL_PROVIDER)
EMAIL_PROVIDER=gmail
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
# Production: paste the full contents of gmail_token.json here so the token
# survives container restarts without a file on disk.
# Leave empty in development (the token file is used instead).
GMAIL_TOKEN_DATA=
GMAIL_SENDER_EMAIL=noreply@amls.com

# App
FRONTEND_URL=http://localhost:3000
INVITATION_EXPIRE_HOURS=48
ENVIRONMENT=development
